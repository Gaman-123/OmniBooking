{
    "name": "gaman/omni-booking",
    "description": "OmniBooking - High-Performance Channel Manager with PHP Laravel & C++ Hybrid Core",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2 || ^8.3",
        "guzzlehttp/guzzle": "^7.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
