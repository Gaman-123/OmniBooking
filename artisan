#!/usr/bin/env php
<?php

require_once __DIR__ . '/vendor/autoload.php';
require_once __DIR__ . '/database/seeders/DatabaseSeeder.php';

use Dotenv\Dotenv;
use App\Database\Connection;
use App\Database\Migrator;
use Database\Seeders\DatabaseSeeder;
use App\Http\Controllers\BookingController;

if (file_exists(__DIR__ . '/.env')) {
    $dotenv = Dotenv::createImmutable(__DIR__);
    $dotenv->safeLoad();
}

$command = $argv[1] ?? 'help';

echo "\n======================================================\n";
echo "  Omni Booking CLI - Hybrid Channel Manager Core\n";
echo "======================================================\n\n";

switch ($command) {
    case 'migrate':
        echo "[*] Running database migrations on " . Connection::getActiveDriver() . "...\n";
        $migrator = new Migrator();
        $logs = $migrator->migrate();
        foreach ($logs as $log) {
            echo "  -> {$log}\n";
        }
        echo "[✓] Migrations finished!\n\n";
        break;

    case 'migrate:reset':
        echo "[!] Dropping all tables...\n";
        $migrator = new Migrator();
        $logs = $migrator->reset();
        foreach ($logs as $log) {
            echo "  -> {$log}\n";
        }
        echo "[✓] Database reset complete.\n\n";
        break;

    case 'db:seed':
        echo "[*] Seeding database with realistic hotels, room types, 30-day matrix & channels...\n";
        $seeder = new DatabaseSeeder();
        $logs = $seeder->run();
        foreach ($logs as $log) {
            echo "  -> {$log}\n";
        }
        echo "[✓] Seeding completed successfully!\n\n";
        break;

    case 'db:status':
        echo "[*] Database Connection Status:\n";
        $status = Connection::getHealthStatus();
        print_r($status);
        echo "\n";
        break;

    case 'cpp:status':
        echo "[*] Querying C++ Algorithmic Core Status...\n";
        $bridge = new \App\Services\CppAlgorithmBridge();
        $res = $bridge->getStatus();
        echo json_encode($res, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n\n";
        break;

    case 'cpp:build':
        echo "[*] Compiling C++ Algorithmic Core Engine with g++...\n";
        $binDir = __DIR__ . '/bin';
        if (!is_dir($binDir)) {
            mkdir($binDir, 0777, true);
        }
        $cmd = 'g++ -std=c++14 -O3 -Icpp/include cpp/src/dynamic_pricing.cpp cpp/src/inventory_allocator.cpp cpp/src/dag_scheduler.cpp cpp/src/rate_parity_auditor.cpp cpp/src/main.cpp -o bin/channel_engine.exe';
        passthru($cmd, $returnVar);
        if ($returnVar === 0) {
            echo "[✓] Compilation succeeded: bin/channel_engine.exe ready!\n\n";
        } else {
            echo "[✗] Compilation failed with code {$returnVar}\n\n";
        }
        break;

    case 'cpp:benchmark':
        echo "[*] Executing C++ Micro-Benchmark (50k RMQ Queries & 30k Pricing Evaluations)...\n";
        $bridge = new \App\Services\CppAlgorithmBridge();
        $res = $bridge->runBenchmark();
        echo json_encode($res, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n\n";
        break;

    case 'cpp:pricing':
        echo "[*] Computing Dynamic Pricing Matrix via C++ Engine...\n";
        $bridge = new \App\Services\CppAlgorithmBridge();
        $res = $bridge->runDynamicPricing();
        echo json_encode($res, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n\n";
        break;

    case 'cpp:dag':
        echo "[*] Solving Directed Acyclic Graph (DAG) Task Schedule via C++ Engine...\n";
        $bridge = new \App\Services\CppAlgorithmBridge();
        $res = $bridge->solveDag();
        echo json_encode($res, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n\n";
        break;

    case 'cpp:parity':
        echo "[*] Auditing Rate Parity across OTA Channels via C++ Engine...\n";
        $bridge = new \App\Services\CppAlgorithmBridge();
        $res = $bridge->auditRateParity();
        echo json_encode($res, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n\n";
        break;

    case 'booking:simulate':
        echo "[*] Simulating incoming OTA booking...\n";
        $controller = new BookingController();
        $res = $controller->simulate();
        echo json_encode($res, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n\n";
        break;

    case 'serve':
        $host = '127.0.0.1';
        $port = 8000;
        echo "[*] Starting OmniBooking Development Server on http://{$host}:{$port}\n";
        echo "    Press Ctrl+C to stop.\n\n";
        passthru("php -S {$host}:{$port} -t public public/index.php");
        break;

    case 'help':
    default:
        echo "Available Commands:\n";
        echo "  php artisan migrate          Run database migrations (MySQL / PostgreSQL / SQLite)\n";
        echo "  php artisan migrate:reset    Drop all database tables\n";
        echo "  php artisan db:seed          Seed sample hotels, room types, inventory & channels\n";
        echo "  php artisan db:status        Test database connection and driver status\n";
        echo "  php artisan cpp:build        Compile C++ Algorithmic Core with g++\n";
        echo "  php artisan cpp:status       Query C++ Engine status and capabilities\n";
        echo "  php artisan cpp:benchmark    Run sub-millisecond C++ micro-benchmarks\n";
        echo "  php artisan cpp:pricing      Compute dynamic pricing using C++ yield engine\n";
        echo "  php artisan cpp:dag          Solve OTA fan-out DAG task schedule using C++ engine\n";
        echo "  php artisan cpp:parity       Audit rate parity & OTA undercutting via C++ engine\n";
        echo "  php artisan booking:simulate Simulate an incoming OTA booking and DAG fan-out\n";
        echo "  php artisan serve            Start the local HTTP development server\n\n";
        break;
}
